{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dartsnut Agent",
  "version": "2.0.0",
  "identifier": "com.dartsnut.agent",
  "build": {
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Dartsnut Agent",
        "width": 1560,
        "height": 980,
        "minWidth": 1320,
        "minHeight": 860,
        "transparent": true,
        "decorations": true,
        "shadow": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* https://*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRUMxQjREOUU3NEZGOTgKUldTWS8zU2VUUnZzdzA0WW5JMG14RStSVUFSVnd4WGpUd3BhUlRKMlZWaXZoSVVYVEZDZU54NU8K",
      "dangerousInsecureTransportProtocol": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Build and deploy Dartsnut games and widgets",
    "longDescription": "Dartsnut Agent desktop application",
    "resources": {
      "../assets": "assets",
      "resources/skills": "skills",
      "../PixelDarts.png": "PixelDarts.png"
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper", "silent": true}
    }
  }
}
