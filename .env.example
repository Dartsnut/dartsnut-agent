# Built-in Settings - Dartsnut LLM provider.
# Requests use the authenticated bridge at DARTSNUT_BASE_API/agent/llm/v1.
# Upstream LLM URL, key, model, account quota, and machine validation stay server-side.

# Dartsnut community / deploy device picker (optional; defaults to production hosts)
# DARTSNUT_BASE_API=https://api.example.com
# DARTSNUT_SUPABASE_URL=https://base.example.com
# DARTSNUT_UPDATER_ENDPOINT=https://updates.example.com/agent-update/latest-{{target}}.json
# DARTSNUT_SUPABASE_ANON_KEY=
# DARTSNUT_SUPABASE_DEVICE_TABLE=remote_devices
# Web Google client ID for direct ID-token login.
# DARTSNUT_GOOGLE_CLIENT_ID=
# Desktop Google OAuth client ID; enables "Continue with Google".
# DARTSNUT_GOOGLE_DESKTOP_CLIENT_ID=
# Optional for desktop clients whose token endpoint requires it.
# DARTSNUT_GOOGLE_DESKTOP_CLIENT_SECRET=

# Optional Firebase Analytics client configuration. Analytics stays disabled
# unless every value is supplied at renderer build time.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Optional: max assistant tool rounds per chat send (default 128, max 128).
# AGENT_TOOL_LOOP_MAX=128
# Disable agent session persistence (isolates sync I/O during beach-ball debugging).
# DARTSNUT_DISABLE_AGENT_SESSION_PERSISTENCE=1

# Release publishing. Required by `pnpm release:publish`.
# DARTSNUT_RELEASE_API_BASE=https://api.example.com
# DARTSNUT_RELEASE_ACCOUNT=
# DARTSNUT_RELEASE_PASSWORD=
# DARTSNUT_RELEASE_DESCRIPTION=

# Tauri updater signing. Required by local signed release builds.
# Keep private key local; never commit it. Use a path valid on the current host:
# macOS: /absolute/path/to/tauri-signing.key
# Windows: C:/Users/you/.tauri/dartsnut-agent.key
# TAURI_SIGNING_PRIVATE_KEY_PATH=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# Must match plugins.updater.pubkey in src-tauri/tauri.conf.json.
# TAURI_SIGNING_PUBLIC_KEY=

# macOS local release signing identity.
# DARTSNUT_MACOS_SIGNING_IDENTITY=
